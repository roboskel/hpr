<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<launch>
    
    <!-- some rosbags need param: use_sim_time = True . If you use scan topic (not from rosbag) or package roll_test , use_sim_time = False -->
    
    <arg name="use_sim_time" default="False" />

    <param name="use_sim_time" value="$(arg use_sim_time)" />

    <node pkg="tf" type="static_transform_publisher" name="" args="0 0 0 0 0 0 1 base_link laser 100"/>

    <!-- Laser scan stacker:  arg is input_topic:=<your input topic to laserscan stacker> -->
    <include file="$(find laserscan_stacker)/launch/laserscan_stacker.launch" pass_all_args="true"/>

    <node pkg="pointcloud2_segments_viz" type="pointcloud2_segments_viz" respawn="false" name="pointcloud2_segments_viz" output="screen">
        <rosparam file="$(find hpr)/config/viz_param.yaml" command="load" />
    </node>

    <include file="$(find pointcloud2_clustering)/launch/pointcloud2_clustering.launch" />
    
    <!-- PointCloud2 cluster tracking:  arg is    method:= <1 or 2>  . You can choose between 1 or 2 value. 1 if you want to delete overlap from clusters and 2 if you do not want to delete the overlap from clusters  -->

    <include file="$(find pointcloud2_cluster_tracking)/launch/pointcloud2_cluster_tracking.launch" pass_all_args="true"/>
</launch>